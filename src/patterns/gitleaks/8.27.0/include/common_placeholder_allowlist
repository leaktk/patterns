        # variations on super[_-]?secret
        '''c3VwZX.(?:zZWNyZX|.c2VjcmV0)|N1cGVy(?:c2VjcmV0|..NlY3Jld)|zdXBlc.(?:NlY3Jld|.zZWNyZX)''',
        # variations on example
        '''ZXhhbXBsZ|V4YW1wbG|leGFtcGxl|RVhBTVBMR|VYQU1QTE|FWEFNUExF''',
    ]
